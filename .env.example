FOUNDRY_API_KEY_AOAI=your-key-here
AOAI_BASE_URL=https://resource-aifoundry-eastus-2.services.ai.azure.com/openai/v1/
MODEL_MAIN=gpt-5.4
MODEL_MINI=gpt-5.4-mini
CU_ENDPOINT=
CU_KEY=

ENABLE_LOCAL_AUTH=false
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=admin123
LOCAL_AUTH_SESSION_HOURS=24
LOCAL_AUTH_COOKIE_NAME=bid_copilot_session

# ========== 各步推理强度 effort（low/medium/high，可选）==========
# 不设则用下方默认值。值越高越准但越慢越贵。模型由 MODEL_MAIN / MODEL_MINI 决定（此处只调 effort）。
# 格式：EFFORT_<阶段> = 默认值   # 第N步 阶段名（用哪个模型）
# 第2步 文件分类（MODEL_MINI）——任务简单，low 够用
EFFORT_CLASSIFY=low

# 第4步 定位关键章节（MODEL_MAIN）      
EFFORT_LOCATE=medium

# 第5步 抽取显式骨架（MODEL_MAIN）
EFFORT_SKELETON=medium

# 第6步 抽取要求条目（MODEL_MAIN）——章节多时最耗时
EFFORT_REQUIREMENTS=medium

# 第7步 归并对齐（MODEL_MAIN）——最吃推理，超大标的(数百条要求)易慢/超时，可降 medium 提速
EFFORT_MERGE=high

# 第8步 生成式补充/安置游离要求（MODEL_MAIN）
EFFORT_SUPPLEMENT=high     
